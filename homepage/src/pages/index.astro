---
import Base from '../layouts/Base.astro';
import PubCard from '../components/PubCard.astro';
import NoteCard from '../components/NoteCard.astro';
import { site } from '../data/site';
import { news } from '../data/news';
import { publications } from '../data/publications';
import { directions } from '../data/research';
import { url } from '../utils';
import { getCollection } from 'astro:content';

const recentNotes = (await getCollection('notes'))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0))
  .slice(0, 3);
---

<Base>
  <!-- ===== Hero ===== -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-text fade-up">
        <p class="hero-greet">Hi, I'm</p>
        <h1 class="hero-name">
          {site.name}
          <span class="hero-name-cn">{site.chineseName}</span>
        </h1>
        <p class="hero-role">{site.role}</p>
        <p class="hero-affil">{site.affiliation} · {site.department}</p>
        <p class="hero-bio">{site.bio}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={`mailto:${site.email}`}>📮 &nbsp;Email Me</a>
          <a class="btn" href={site.github} target="_blank" rel="noopener">GitHub</a>
          <a class="btn" href={url('cv')}>CV</a>
        </div>
        <p class="hero-location">📍 {site.location}</p>
      </div>
      <img class="hero-photo fade-up-1" src={url('images/gjw.jpg')} alt={`${site.name} profile photo`} />
    </div>
  </section>

  <div class="container">
    <!-- ===== News ===== -->
    <section class="section fade-up-1">
      <div class="section-head">
        <h2 class="section-title">News</h2>
      </div>
      <ul class="news-list">
        {
          news.map((n) => (
            <li class:list={['news-item', n.highlight && 'highlight']}>
              <span class="news-date">{n.date}</span>
              <span class="news-text" set:html={n.html} />
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ===== Research Interests ===== -->
    <section class="section fade-up-2">
      <div class="section-head">
        <h2 class="section-title">Research Interests</h2>
        <a class="section-more" href={url('research')}>View all →</a>
      </div>
      <div class="grid-auto">
        {
          directions.map((d) => (
            <div class="card">
              <div class="card-icon" aria-hidden="true">{d.icon}</div>
              <h3 class="card-title">{d.title}</h3>
              <p class="card-text">{d.description}</p>
              {d.points && (
                <ul class="card-list">
                  {d.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              )}
            </div>
          ))
        }
      </div>
    </section>

    <!-- ===== Selected Publications ===== -->
    <section class="section fade-up-2">
      <div class="section-head">
        <h2 class="section-title">Selected Publications</h2>
        <a class="section-more" href={url('publications')}>View all →</a>
      </div>
      {publications.map((pub) => <PubCard pub={pub} />)}
    </section>

    <!-- ===== Latest Notes ===== -->
    <section class="section fade-up-3">
      <div class="section-head">
        <h2 class="section-title">Latest Notes</h2>
        <a class="section-more" href={url('notes')}>View all →</a>
      </div>
      <div class="grid-auto">
        {recentNotes.map((note) => <NoteCard note={note} />)}
      </div>
    </section>
  </div>
</Base>

<style>
  /* ===== Hero ===== */
  .hero {
    position: relative;
    padding-block: 1.75rem 0.75rem;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -180px;
    right: -120px;
    width: 480px;
    height: 480px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      var(--accent-soft) 0%,
      transparent 65%
    );
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
  }

  .hero-greet {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .hero-name {
    margin: 0;
    font-size: clamp(2rem, 5vw, 2.9rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .hero-name-cn {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.45em;
    font-weight: 600;
    background: linear-gradient(120deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-role {
    margin-top: 1.1rem;
    font-size: 1.08rem;
    font-weight: 600;
    color: var(--fg);
  }

  .hero-affil {
    margin-top: 0.3rem;
    font-size: 0.92rem;
    color: var(--fg-muted);
  }

  .hero-bio {
    margin-top: 1rem;
    max-width: 34rem;
    font-size: 0.95rem;
    color: var(--fg-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.5rem;
  }

  .hero-location {
    margin-top: 1.1rem;
    font-size: 0.86rem;
    color: var(--fg-subtle);
  }

  .hero-photo {
    flex-shrink: 0;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: var(--shadow-md);
    border: 4px solid var(--bg-elev);
    outline: 1px solid var(--border);
    outline-offset: 4px;
  }

  @media (max-width: 720px) {
    .hero-inner {
      flex-direction: column-reverse;
      text-align: center;
      gap: 2rem;
    }
    .hero-photo {
      width: 150px;
      height: 150px;
    }
    .hero-actions {
      justify-content: center;
    }
    .hero-bio {
      margin-inline: auto;
    }
  }
</style>
