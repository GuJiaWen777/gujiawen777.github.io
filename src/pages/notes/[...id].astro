---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { url } from '../../utils';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({
    params: { id: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const { title, description, category, date, tags } = note.data;
const dateStr = date
  ? date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })
  : '';
---

<Base title={`${title} — Notes`} description={description}>
  <div class="container">
    <a class="back-link" href={url('notes')}>← 所有笔记</a>

    <header class="note-header">
      <p class="note-meta">
        <span class="tag">{category}</span>
        {dateStr && <span class="note-date">{dateStr}</span>}
      </p>
      <h1 class="note-title">{title}</h1>
      {
        tags.length > 0 && (
          <div class="tags note-tags">
            {tags.map((t) => (
              <span class="tag">{t}</span>
            ))}
          </div>
        )
      }
    </header>

    <article class="prose">
      <Content />
    </article>

    <a class="back-link back-link-bottom" href={url('notes')}>← 返回笔记列表</a>
  </div>
</Base>

<style>
  .back-link {
    display: inline-block;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--fg-muted);
  }
  .back-link:hover { color: var(--accent); }

  .back-link-bottom {
    display: inline-block;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--border);
    width: 100%;
  }

  .note-header {
    margin-block: 1.75rem 2.5rem;
  }

  .note-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .note-date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--fg-subtle);
  }

  .note-title {
    margin: 0;
    font-size: clamp(1.6rem, 4vw, 2.1rem);
    font-weight: 800;
  }

  .note-tags {
    margin-top: 1rem;
  }
</style>
