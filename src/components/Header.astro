---
import ThemeToggle from './ThemeToggle.astro';
import { url } from '../utils';

const items = [
  { href: url(), label: 'Home' },
  { href: url('research'), label: 'Research' },
  { href: url('publications'), label: 'Publications' },
  { href: url('cv'), label: 'CV' },
  { href: url('notes'), label: 'Notes' },
];

const cur = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={url()}>
      <span class="brand-mark" aria-hidden="true">G</span>
      <span class="brand-text">Jiawen&nbsp;Gu</span>
    </a>
    <nav class="site-nav" aria-label="主导航">
      {
        items.map((item) => (
          <a
            class:list={[
              'nav-link',
              cur === item.href.replace(/\/+$/, '') && 'active',
            ]}
            href={item.href}
          >
            {item.label}
          </a>
        ))
      }
      <ThemeToggle />
    </nav>
  </div>
</header>
